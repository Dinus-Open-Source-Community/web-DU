# POSTGRESQL ENVIRONMENT VARIABLES

POSTGRES_USER=root
POSTGRES_PASSWORD=mystrongpassword
POSTGRES_DB=myapp_db

# =============================================

# BACKEND ENVIRONMENT VARIABLES

# Base URL for backend service
BASE_URL=http://backend:8080 # Sesuaikan dengan alamat backend docker-compose

# Environment variables for database connection
DB_HOST=db
DB_PORT=5432 # Default PostgreSQL port
DB_USER=root
DB_PASSWORD=mystrongpassword
DB_NAME=myapp_db
DB_SSLMODE=disable

# Environment variable for JWT secret key
JWT_SECRET_KEY=supersecret

# Key for encryption
AES_KEY=your_encryption_key_here
HMAC_KEY=your_hmac_key_here

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Payment Gateway Credentials
TRIPAY_MERCHANT_CODE=your_merchant_code_here
TRIPAY_API_KEY=your_api_key_here
TRIPAY_PRIVATE_KEY=your_private_key_here

# ==============================================

# FRONTEND ENVIRONMENT VARIABLES

NEXT_PUBLIC_API_URL=http://backend:8080