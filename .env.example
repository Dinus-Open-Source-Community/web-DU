# POSTGRESQL ENVIRONMENT VARIABLES

POSTGRES_USER=doscom_user
POSTGRES_PASSWORD=doscom12345
POSTGRES_DB=doscom_db

# =============================================

# BACKEND ENVIRONMENT VARIABLES

# Base URL for backend service
BASE_URL=http://localhost:8080 # Sesuaikan dengan alamat backend docker-compose

# Frontend URL used for OAuth callback redirects
FRONTEND_BASE_URL=http://localhost:3000
# Origin browser yang diizinkan (CORS). Pisahkan dengan koma.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Environment variables for database connection
DB_HOST=localhost
DB_PORT=5430
DB_USER=doscom_user
DB_PASSWORD=doscom12345
DB_NAME=doscom_db
DB_SSLMODE=disable

# Optional internal Redis cache; backend falls back to PostgreSQL if unavailable.
REDIS_ENABLED=true
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=20
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s
REDIS_AUTH_CACHE_TTL=45s

# Environment variable for JWT secret key
JWT_SECRET_KEY=your_jwt_secret_key

# External redeem-code API key. Generate a unique secret for each environment.
REDEEM_CODE_API_KEY=replace_with_random_64_hex

# Key for encryption
AES_KEY=your_aes_key
HMAC_KEY=your_hmac_key

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# DOSCOM SSO (OAuth2 Authorization Code + PKCE) — https://sso-docs.doscom.org
# client_id/secret didapat dari Developer Console https://sso.doscom.org/developer/login
SSO_BASE_URL=https://sso.doscom.org
SSO_CLIENT_ID=your_sso_client_id_here
SSO_CLIENT_SECRET=your_sso_client_secret_here
# Callback backend — HARUS sama persis dengan Redirect URI yang terdaftar di Developer Console
SSO_REDIRECT_URI=http://localhost:8080/auth/sso/callback
# Tujuan akhir browser setelah login TIDAK dikonfigurasi di sini — frontend
# mengirimnya per-request via ?next= pada /auth/sso/login (path relatif
# seperti /dashboard, atau URL penuh yang origin-nya terdaftar di
# FRONTEND_BASE_URL / CORS_ALLOWED_ORIGINS). Tanpa ?next=, fallback ke
# FRONTEND_BASE_URL + /auth/sso/callback.

# Garage S3 Storage Configuration
GARAGE_ENDPOINT=garage:3900
GARAGE_PUBLIC_ENDPOINT=localhost:3900
GARAGE_WEB_ENDPOINT=web.garage.localhost:3902
GARAGE_ADMIN_ENDPOINT=http://garage:3903
# Token admin & metrics Garage — nilainya di-inject ke container Garage sebagai
# env override (GARAGE_ADMIN_TOKEN / GARAGE_METRICS_TOKEN), bukan di garage.toml.
# Generate: openssl rand -hex 32
GARAGE_ADMIN_TOKEN=84ccfa2cd3d0c145589c0acaa3fc4267f90f5979ae7b8b27d7562f8edee9c4a9
GARAGE_METRICS_TOKEN=23277dd513fa5368ab44e4f06a8f00d3b810e5b697959f30da143d384cc085d0
# rpc_secret cluster Garage (openssl rand -hex 32)
GARAGE_RPC_SECRET=068d934387ea980ccce9fe5c4d07d4d04ddf45b7bbb5524882c64903d9e7441e
GARAGE_REGION=garage
# access key id = "GK" + 24 hex, secret = 64 hex
GARAGE_ACCESS_KEY=GK3ae2be21108e94f1edb33e6f95f97522336b64bb7554613d3028377eebeb6a39
GARAGE_SECRET_KEY=2de6bdb49a2340e7710a83ed91ada2e9f69efc573069d639285fd3132fb770f4
GARAGE_USE_SSL=false
GARAGE_BUCKET_AVATARS=avatars
GARAGE_BUCKET_COURSES=courses
GARAGE_BUCKET_ASSIGNMENTS=lesson-assignments
GARAGE_BUCKET_GALLERIES=galleries

# SMTP Mailer Configuration
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=doscom.go@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="doscom.go@gmail.com"
MAIL_FROM_NAME="DOSCOM University"

# ==============================================

# FRONTEND ENVIRONMENT VARIABLES

VITE_BACKEND_URL=http://localhost:8080
