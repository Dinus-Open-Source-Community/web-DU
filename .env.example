# POSTGRESQL ENVIRONMENT VARIABLES

POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD="your_postgres_password"
POSTGRES_DB=your_postgres_db

# =============================================

# BACKEND ENVIRONMENT VARIABLES

# Base URL for backend service
BASE_URL=http://localhost:8080 # Sesuaikan dengan alamat backend docker-compose

# Environment variables for database connection
DB_HOST=db
DB_PORT=5432 # Default PostgreSQL port
DB_USER=your_db_user
DB_PASSWORD="your_db_password"
DB_NAME=your_db_name
DB_SSLMODE=disable

# Environment variable for JWT secret key
JWT_SECRET_KEY=your_jwt_secret_key

# Key for encryption
AES_KEY=your_aes_key
HMAC_KEY=your_hmac_key

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# DOSCOM SSO (OAuth2 Authorization Code + PKCE) — https://sso-docs.doscom.org
# client_id/secret didapat dari Developer Console https://sso.doscom.org/developer/login
SSO_BASE_URL=https://sso.doscom.org
SSO_CLIENT_ID=your_sso_client_id_here
SSO_CLIENT_SECRET=your_sso_client_secret_here
# Callback backend — HARUS sama persis dengan Redirect URI yang terdaftar di Developer Console
SSO_REDIRECT_URI=http://localhost:8080/auth/sso/callback
# Tujuan akhir browser setelah login TIDAK dikonfigurasi di sini — frontend
# mengirimnya per-request via ?next= pada /auth/sso/login (path relatif
# seperti /dashboard, atau URL penuh yang origin-nya terdaftar di
# FRONTEND_BASE_URL / CORS_ALLOWED_ORIGINS). Tanpa ?next=, fallback ke
# FRONTEND_BASE_URL + /auth/sso/callback.

# Payment Gateway Credentials
TRIPAY_MERCHANT_CODE=your_tripay_merchant_code
TRIPAY_API_KEY=your_tripay_api_key
TRIPAY_PRIVATE_KEY=your_tripay_private_key

# MinIO Configuration
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_USE_SSL=false
MINIO_BUCKET_AVATARS=avatars
MINIO_BUCKET_COURSES=courses
MINIO_BUCKET_INVOICES=invoices
MINIO_BUCKET_ASSIGNMENTS=lesson-assignments

# HAPUS SAJA PADA SAAT PRODUCTION, INI HANYA UNTUK SEEDER SAJA
# Seeder Configuration
SEED=false # Set ke 'true' untuk menjalankan seeder saat aplikasi start

# ==============================================

# FRONTEND ENVIRONMENT VARIABLES

NEXT_PUBLIC_API_URL=http://backend:8080
NEXT_PUBLIC_USE_MOCK_DATA=false

# ==============================================

# MINIO ENVIRONMENT VARIABLES

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123