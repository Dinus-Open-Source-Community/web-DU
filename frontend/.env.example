# Copy this file to `.env.local` for local development.

# Public app base URL (frontend)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend origin yang dipakai Next.js untuk me-rewrite request `/api/*`.
# Dibaca di server (bukan bundle client), jadi TANPA prefix NEXT_PUBLIC_.
# Biarkan kosong kalau backend jalan di http://localhost:8080.
# BACKEND_INTERNAL_URL=http://localhost:8080

# Base URL request API dari browser. Default `/api` (same-origin via proxy
# Next.js, aman dari CORS). Isi absolute URL hanya kalau ingin memaksa
# browser hit backend langsung (backend WAJIB punya CORS yang benar).
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Keep mock data disabled in all environments.
NEXT_PUBLIC_USE_MOCK_DATA=false

# Optional mentor schedule endpoint for dashboard calendar sync.
# NEXT_PUBLIC_MENTOR_SCHEDULES_ENDPOINT=

# Optional Google APIs for mentor calendar integration feature.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# NEXT_PUBLIC_GOOGLE_API_KEY=
