# Salin ke `.env.local` untuk pengembangan.

# `true` = aktifkan fixture (dummyData, seed localStorage). Di production set `false`.
NEXT_PUBLIC_USE_MOCK_DATA=true

# Opsional: tampilan nama/email/role di sidebar hingga Auth terhubung.
# NEXT_PUBLIC_SESSION_NAME=
# NEXT_PUBLIC_SESSION_EMAIL=
# NEXT_PUBLIC_SESSION_ROLE=Student
# NEXT_PUBLIC_SESSION_AVATAR=

# Opsional: endpoint jadwal mentor (jika diisi, useMentorDashboard mengambil JSON).
# NEXT_PUBLIC_MENTOR_SCHEDULES_ENDPOINT=
