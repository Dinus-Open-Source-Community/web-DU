# Backend Url Configuration
BASE_URL=http://localhost:8080 # Sesuaikan dengan alamat backend docker-compose
# Sertakan port yang dipakai browser (docker-compose frontend: 3001; vite dev: 5173)
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Frontend URL used for OAuth callback redirects
FRONTEND_BASE_URL=http://localhost:3000

# Environment variables for database connection
DB_HOST=localhost
DB_PORT=5432 # Default PostgreSQL port
DB_USER=myuser
DB_PASSWORD=mysecretpassword
DB_NAME=mydb
DB_SSLMODE=disable

# Redis cache (optional; PostgreSQL remains the fallback)
REDIS_ENABLED=false
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=20
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s
REDIS_AUTH_CACHE_TTL=45s

# Environment variable for JWT secret key
JWT_SECRET_KEY=your_jwt_secret_key_here

# External redeem-code API key. Use a long random secret; empty disables the endpoint.
REDEEM_CODE_API_KEY=

# Key for encryption
AES_KEY=your_encryption_key_here
HMAC_KEY=your_hmac_key_here

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# Optional explicit backend callback URL if different from default.
# GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8080/oauth/google/callback

# DOSCOM SSO (OAuth2 Authorization Code + PKCE) — https://sso-docs.doscom.org
# client_id/secret didapat dari Developer Console https://sso.doscom.org/developer/login
SSO_BASE_URL=https://sso.doscom.org
SSO_CLIENT_ID=your_sso_client_id_here
SSO_CLIENT_SECRET=your_sso_client_secret_here
# Callback backend — HARUS sama persis dengan Redirect URI yang terdaftar di Developer Console
SSO_REDIRECT_URI=http://localhost:8080/auth/sso/callback
# Tujuan akhir browser setelah login TIDAK dikonfigurasi di sini — frontend
# mengirimnya per-request via ?next= pada /auth/sso/login (path relatif
# seperti /dashboard, atau URL penuh yang origin-nya terdaftar di
# FRONTEND_BASE_URL / CORS_ALLOWED_ORIGINS). Tanpa ?next=, fallback ke
# FRONTEND_BASE_URL + /auth/sso/callback.

# Garage S3 Object Storage Configuration
GARAGE_ENDPOINT=garage:3900
GARAGE_PUBLIC_ENDPOINT=localhost:3900
GARAGE_WEB_ENDPOINT=web.garage.localhost:3902
GARAGE_ADMIN_ENDPOINT=http://garage:3903
# Harus SAMA dengan GARAGE_ADMIN_TOKEN di .env root (dipakai juga oleh garage.toml via env override)
GARAGE_ADMIN_TOKEN=replace_with_random_64_hex
GARAGE_REGION=garage
GARAGE_ACCESS_KEY=GKreplace_with_24_hex_chars
GARAGE_SECRET_KEY=replace_with_random_64_hex
GARAGE_USE_SSL=false
GARAGE_BUCKET_AVATARS=avatars
GARAGE_BUCKET_COURSES=courses
GARAGE_BUCKET_ASSIGNMENTS=lesson-assignments
GARAGE_BUCKET_GALLERIES=galleries
# Aman dijalankan berulang: hanya INSERT data baru / SKIP yang sudah ada.

# !COPY FILE DULU BARU EDIT! #
# FUNGSI DARI FILE INI DIGUNAKAN UNTUK MENYIMPAN VARIABEL LINGKUNGAN BACKEND (BERBEDA DENGAN .env YANG ADA DILUAR) #

# SMTP Mailer Configuration
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=doscom.go@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="doscom.go@gmail.com"
MAIL_FROM_NAME="DOSCOM University"
