# Backend Url Configuration
BASE_URL=http://localhost:8080 # Sesuaikan dengan alamat backend docker-compose
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000 # Pisahkan dengan koma untuk whitelist origin frontend

# Frontend URL used for OAuth callback redirects
FRONTEND_BASE_URL=http://localhost:3000

# Environment variables for database connection
DB_HOST=localhost
DB_PORT=5432 # Default PostgreSQL port
DB_USER=myuser
DB_PASSWORD=mysecretpassword
DB_NAME=mydb
DB_SSLMODE=disable

# Environment variable for JWT secret key
JWT_SECRET_KEY=your_jwt_secret_key_here

# Key for encryption
AES_KEY=your_encryption_key_here
HMAC_KEY=your_hmac_key_here

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# Optional explicit backend callback URL if different from default.
# GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8080/oauth/google/callback

# Payment Gateway Credentials
TRIPAY_MERCHANT_CODE=your_merchant_code_here
TRIPAY_API_KEY=your_api_key_here
TRIPAY_PRIVATE_KEY=your_private_key_here

# MinIO Object Storage Configuration
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_USE_SSL=false
MINIO_BUCKET_AVATARS=avatars
MINIO_BUCKET_COURSES=courses
MINIO_BUCKET_INVOICES=invoices
MINIO_BUCKET_ASSIGNMENTS=lesson-assignments

# Seeder Configuration
SEED=false # Set ke 'true' untuk menjalankan seeder saat aplikasi start

# !COPY FILE DULU BARU EDIT! #
# FUNGSI DARI FILE INI DIGUNAKAN UNTUK MENYIMPAN VARIABEL LINGKUNGAN BACKEND (BERBEDA DENGAN .env YANG ADA DILUAR) #